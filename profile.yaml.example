personal:
  name: "Priyanshu Raj"
  email: "you@example.com"
  phone: "+91-XXXXXXXXXX"
  location: "India"
  linkedin: "https://linkedin.com/in/your-handle"
  github: "https://github.com/NeverSpot"
  portfolio: "https://example.com"

education:
  degree: "BTech Computer Science"
  institution: "KIIT University"
  graduation_year: 2026
  cgpa: 8.14
  achievements:
    - "Codeforces Expert (max 1825)"
    - "CodeChef 5-Star (max 2027)"
    - "IICPC Regionalist — 56th rank regionals, 276th Prelims 2025"
    - "ICPC Regionalist — Rank 42 Kanpur 2025"
    - "1800+ problems solved across platforms"

professional:
  target_roles:
    - "Software Development Engineer"
    - "Backend Engineer"
    - "Applied AI Engineer"
    - "SDE Intern"
  core_stack:
    - "C++"
    - "TypeScript"
    - "Java"
    - "Go"
    - "Node.js"
    - "Express"
    - "MySQL"
    - "MongoDB"
    - "Redis"
    - "AWS (EC2, RDS)"
    - "Linux"
    - "Nginx"
  experience_years: 0
  preferred_locations:
    - "India"
    - "Remote"
    - "Bangalore"
    - "Hyderabad"
    - "Pune"
  excluded_keywords:
    - "3+ years"
    - "5+ years"
    - "7+ years"
    - "senior"
    - "lead"
    - "principal"
    - "architect"

notion:
  # ID of the target Notion database (the "job list" database).
  # Replace with your own database id, or omit this entirely and supply the
  # NOTION_DB_ID environment variable instead (the env var takes precedence).
  database_id: "YOUR_NOTION_DATABASE_ID"
  # NOTION_API_KEY is read from the environment variable — never store it here.

scoring:
  # The six weighted factors of the v6 0-100 fit score, with their band caps.
  # Employer prestige is deliberately NOT a factor — it is only a tie-breaker.
  weights:
    role_match: 30        # A. target role / engineering role
    graduate_fit: 20      # B. new-grad, junior, intern, or <=1y stated
    location_eligibility: 20  # C. India, worldwide remote, remote, other
    stack_overlap: 15     # D. hits against professional.core_stack
    freshness: 10         # E. age of the posting
    listing_confidence: 5  # F. is the URL a specific posting?
  thresholds:
    p1_critical: 85
    p2_high: 70
    p3_medium: 55
    p4_watchlist: 0
  # Rows that fail the liveness check this many times are demoted.
  unknown_demote_after: 3

# Employer names used only to break ties between equally scored rows.
tier1_companies:
  - "stripe"
  - "uber"
  - "airbnb"
  - "databricks"
  - "snowflake"
  - "anthropic"
  - "openai"
  - "google"
  - "meta"
  - "amazon"
  - "microsoft"
  - "netflix"
  - "figma"
  - "notion"
  - "linear"
  - "vercel"
  - "retool"
  - "n8n"
  - "elevenlabs"

# The v6 pipeline fetches from these sources. The per-company ATS board slugs
# live in scripts/job_hunter.py (LEVER_BOARDS, GREENHOUSE_BOARDS, ASHBY_BOARDS).
sources:
  simplify_jobs: true    # aggregator: SimplifyJobs New-Grad-Positions
  remoteok: true         # aggregator: RemoteOK (entry-level tag filter)
  lever: true            # per-company Lever boards
  greenhouse: true       # per-company Greenhouse boards
  ashby: true            # per-company Ashby boards
